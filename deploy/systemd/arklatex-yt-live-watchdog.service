[Unit]
Description=ArkLaTex YouTube-liveness watchdog (oneshot; scheduled by timer)

[Service]
Type=oneshot
# The cold-stop-wait-restart escalation path can run ~5 min (COLD_STOP_WAIT +
# POST_ESCALATION_PROBE_WAIT + probe overhead) -- well past systemd's default
# 90s TimeoutStartSec, which would otherwise kill the script mid-escalation.
TimeoutStartSec=600
ExecStart=/opt/arklatex/deploy/yt-live-watchdog.sh
